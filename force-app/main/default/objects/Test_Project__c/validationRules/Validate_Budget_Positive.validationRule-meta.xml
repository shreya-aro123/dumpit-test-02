<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validate_Budget_Positive</fullName>
    <active>true</active>
    <description>Ensures budget amount is not negative.</description>
    <errorConditionFormula>Budget_Amount__c &lt; 0</errorConditionFormula>
    <errorDisplayField>Budget_Amount__c</errorDisplayField>
    <errorMessage>Budget amount must be a positive value.</errorMessage>
</ValidationRule>
